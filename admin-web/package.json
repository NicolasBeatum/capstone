{
  "name": "duocmind-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "dev:remote": "vite --host 127.0.0.1 --mode remote",
    "predev:remote": "node ../DuocMind/tools/scripts/remote-env.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
